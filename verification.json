{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party",
        "pnpm run test:site"
      ]
    },
    {
      "name": "typecheck",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run typecheck"
      ]
    },
    {
      "name": "terrace",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run test:terrace",
        "pnpm run test:demo"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "pnpm run test:runtime",
        "pnpm run test:email-link",
        "pnpm run test:app-journey"
      ]
    }
  ],
  "nightly": [
    {
      "name": "owned-installation",
      "browser": true,
      "hosted": false,
      "commands": [
        "node tests/owned-installation.mjs",
        "node tests/open-installation.mjs"
      ]
    },
    {
      "name": "custom-reports",
      "browser": true,
      "hosted": false,
      "commands": [
        "node tests/custom-browser.mjs"
      ]
    },
    {
      "name": "dispatch",
      "browser": true,
      "hosted": false,
      "commands": [
        "node tests/dispatch-browser.mjs"
      ]
    },
    {
      "name": "move-out",
      "browser": true,
      "hosted": false,
      "commands": [
        "node tests/move-out-browser.mjs"
      ]
    }
  ]
}
