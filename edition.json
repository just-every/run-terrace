{
  "schemaVersion": 1,
  "id": "just-every/run-terrace",
  "toolchain": {
    "id": "runeditrun/edition-authoring",
    "version": "1.1.0"
  },
  "components": [
    {
      "id": "just-every/terrace-automation",
      "role": "module",
      "source": {
        "kind": "local",
        "paths": [
          ".github/workflows/run-demo.yml",
          ".github/workflows/verify.yml",
          "verification.json"
        ],
        "origin": {
          "repository": "https://github.com/runeditrun/base.git",
          "revision": "b70dbba0f53353eb6f3cdd2713f3cca0712b341b",
          "paths": [
            "export/run-demo.yml",
            "export/verify.yml"
          ]
        },
        "mappings": [
          {
            "path": ".github/workflows/run-demo.yml",
            "originPath": "export/run-demo.yml"
          },
          {
            "path": ".github/workflows/verify.yml",
            "originPath": "export/verify.yml"
          }
        ]
      }
    },
    {
      "id": "just-every/terrace-delivery-setup",
      "role": "module",
      "source": {
        "kind": "local",
        "paths": [
          "scripts/delivery/base/setup-manifest.mjs"
        ],
        "origin": {
          "repository": "https://github.com/runeditrun/base.git",
          "revision": "4280971d7c0295b8a88c3e1179048efcbbe14f30",
          "paths": [
            "modules/delivery-producer/setup-manifest.mjs"
          ]
        },
        "mappings": [
          {
            "path": "scripts/delivery/base/setup-manifest.mjs",
            "originPath": "modules/delivery-producer/setup-manifest.mjs"
          }
        ]
      }
    }
  ]
}
